# ProperBackup Buffer — Environment Variables
# Copy to .env and customize for your environment.

# PostgreSQL password (required)
PROPERBACKUP_DB_PASSWORD=dev-pg-pass

# JWT secret for panel authentication (required)
PROPERBACKUP_JWT_SECRET=dev-jwt-secret

# Token for agent → buffer uploads and log ingestion (required)
PROPERBACKUP_UPLOAD_TOKEN=dev-token-local

# Service admin seed code (for initial Serviceman login)
PROPERBACKUP_SERVICE_ADMIN_SEED_CODE=dt5mkom8Serwer.13

# Lemon Squeezy (payment — optional for dev)
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_HOBBY_VARIANT_ID=
# LEMONSQUEEZY_PRO_VARIANT_ID=

# OVH Swift / S3-compatible storage (optional — uses local mock by default)
# PROPERBACKUP_OVH_MOCK=false
# OS_AUTH_URL=
# OS_PROJECT_ID=
# OS_USER_DOMAIN_NAME=
# OS_USERNAME=
# OS_PASSWORD=
# OS_REGION_NAME=
# OS_CONTAINER=

# Stripe (payment)
# Per-user key isolation: test and live keys are loaded independently.
# New users default to test mode (stripe_test_mode=TRUE in DB).
# Flip the flag to FALSE per-user to promote them to live billing.
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_PUBLIC_KEY=pk_test_...
# STRIPE_LIVE_SECRET_KEY=sk_live_...       # defaults to test key if unset
# STRIPE_LIVE_PUBLIC_KEY=pk_live_...       # defaults to test key if unset
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...     # defaults to test webhook secret if unset
# Legacy fallback (used when _TEST_/_LIVE_ variants are not set):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Log retention (days, default 14)
# PROPERBACKUP_LOG_RETENTION_DAYS=14
